{
  "manifest_version": 3,
  "name": "ZXTabs Reader",
  "version": "0.2.1",
  "description": "Read Ultimate Guitar tabs full screen in a dark, multi-column layout that fits the whole song.",
  "permissions": ["storage"],
  "action": {
    "default_title": "ZXTabs Reader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://tabs.ultimate-guitar.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
